# Paper mode needs none of these. Do not commit filled-in secrets.

# HLGUARD_VENUE=paper
# HLGUARD_MARKET_SOURCE=file
# HLGUARD_LLM=mock

# Mainnet needs allow_mainnet=true in the config file AND this env var.
# The env var alone does nothing while allow_mainnet is false.
# HLGUARD_ALLOW_MAINNET=1
# HYPERLIQUID_API_WALLET_KEY=
# HLGUARD_ACCOUNT_ADDRESS=

# Optional OpenAI-compatible chat model. Evals do not use this.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional Anthropic Messages API via the official SDK.
# Install first: python3 -m pip install -e ".[anthropic]"
# Evals do not use this. The default provider stays the offline mock.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=1024

# Router: try providers in order, then fall back. Default chain is anthropic,openai.
# HLGUARD_LLM=router
# HLGUARD_LLM_PROVIDERS=anthropic,openai
# HLGUARD_LLM_TIMEOUT=60
# HLGUARD_LLM_RETRIES=1
# The router rejects gullible. The offline mock is allowed only with this flag.
# HLGUARD_ROUTER_ALLOW_MOCK=1

# Optional. If unset, Holdfast generates one under the data dir (mode 0600).
# HLGUARD_APPROVAL_SECRET=

# Optional OTLP collector. Spans are always written to data/traces.jsonl.
# OTEL_EXPORTER_OTLP_ENDPOINT=
